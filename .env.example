# Example environment variables for SistemPenunjangKeputusan
# Copy this to `.env` and fill values for your environment.

# Database configuration (replace the placeholders)
# e.g. DB_HOST=192.0.2.10 or DB_HOST=localhost
DB_HOST=your_db_host_or_ip
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name
DB_DRIVER=your_db_driver # e.g. mysqli
DB_PREFIX=your_table_prefix_optional
DB_CHARSET=your_charset # e.g. utf8
DB_DBCOLLAT=your_collation # e.g. utf8_general_ci
DB_PCONNECT=false
DB_SAVE_QUERIES=true

# Optional: override CodeIgniter environment (development/production)
#CI_ENVIRONMENT=development
